// racer.js class Racer { constructor(nome) { this.nome = nome; this.posicao = 0; this.itens = []; }

mover() { const avancar = Math.floor(Math.random() * 6) + 1; this.posicao += avancar; console.log(${this.nome} andou ${avancar} casas!); }

usarItem() { if (this.itens.length > 0) { const item = this.itens.shift(); console.log(${this.nome} usou ${item.nome}); item.efeito(this); } } }

module.exports = Racer;

// items.js const items = [ { nome: 'Casco Verde', efeito: (alvo) => { alvo.posicao -= 2; console.log(${alvo.nome} foi atingido e voltou 2 casas!); } }, { nome: 'Cogumelo', efeito: (racer) => { racer.posicao += 3; console.log(${racer.nome} acelerou com o Cogumelo!); } } ];

