function iniciarCorrida(jogadorNome) { const jogador = new Racer(jogadorNome); const adversario = new Racer("Bowser");

while (jogador.posicao < 30 && adversario.posicao < 30) { jogador.mover(); adversario.mover();

if (Math.random() < 0.3) {
  const item = items[Math.floor(Math.random() * items.length)];
